<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg_classic"><LinearLayout android:id="@+id/widget_content" android:orientation="vertical" android:padding="14dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"> <TextView android:id="@+id/widget_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="清远 · 今日课表" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_settings" android:layout_width="32dp" android:layout_height="24dp" android:text="⋯" android:gravity="center" android:textColor="@color/widget_muted" android:textSize="20sp" android:contentDescription="小部件设置"/></LinearLayout>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="下一节课" android:textColor="@color/widget_text" android:textSize="12sp" android:fontFamily="sans" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="课程名称" android:textColor="@color/widget_text" android:textSize="18sp" android:fontFamily="sans" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="5dp"/>
 <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:30–09:55" android:textColor="@color/widget_text" android:textSize="14sp" android:fontFamily="sans" android:layout_marginTop="4dp" android:maxLines="1"/>
 <TextView android:id="@+id/widget_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="教室" android:textColor="@color/widget_text" android:textSize="12sp" android:fontFamily="sans" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end"/>
 <LinearLayout android:id="@+id/widget_rows" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="8dp" android:orientation="vertical" android:background="@drawable/widget_row"><TextView android:id="@+id/row_name0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="课程名称" android:textColor="@color/widget_text" android:textSize="14sp" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/><TextView android:id="@+id/row_info0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:30–09:55 · 教室" android:textColor="@color/widget_text" android:textSize="12sp" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end"/></LinearLayout><LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="8dp" android:orientation="vertical" android:background="@drawable/widget_row"><TextView android:id="@+id/row_name1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="课程名称" android:textColor="@color/widget_text" android:textSize="14sp" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"/><TextView android:id="@+id/row_info1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:30–09:55 · 教室" android:textColor="@color/widget_text" android:textSize="12sp" android:fontFamily="sans" android:maxLines="1" android:ellipsize="end"/></LinearLayout></LinearLayout>
 <LinearLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
 <LinearLayout android:id="@+id/widget_bottom" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical"><TextView android:id="@+id/widget_footer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="第5周 · 点按查看" android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_refresh" android:layout_width="32dp" android:layout_height="24dp" android:gravity="center" android:text="↻" android:textSize="20sp" android:textColor="@color/widget_muted" android:contentDescription="刷新课表"/></LinearLayout>
 </LinearLayout></FrameLayout>